@startuml
' =======================================================
' RF1 – Adicionar Contato
' =======================================================
actor Usuario
participant "Interface" as UI
participant "Agenda" as Agenda
participant "Contato" as Contato

== RF1 - Adicionar Contato ==
Usuario -> UI : solicitarAdicionarContato()
UI -> Usuario : solicitarDadosContato()
Usuario -> UI : enviarDadosContato(nome, telefone)
UI -> Contato : new Contato(nome, telefone)
UI -> Agenda : adicionarContato(contato)
Agenda -> Agenda : armazenarContato()
Agenda --> UI : confirmarAdicao()
UI --> Usuario : mostrarMensagemSucesso()
@enduml

